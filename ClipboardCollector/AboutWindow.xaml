<Window x:Class="ClipboardCollector.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ClipboardCollector"
        Icon="app.ico"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,20" MinWidth="320">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="64" Height="64" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="18,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="ClipboardCollector" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="Version · build time · commit" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
                   Text="Collects text you copy, for example answers from web-based AI chats, into one Markdown document you can edit, save and export as PDF." />

        <TextBlock x:Name="CreditText" Margin="0,14,0,0" FontWeight="SemiBold" />
        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Built with Markdig, Microsoft Edge WebView2 and Velopack." />
        <TextBlock Margin="0,2,0,0">
            <Hyperlink x:Name="RepoLink" RequestNavigate="RepoLink_RequestNavigate">
                <Run x:Name="RepoLinkText" />
            </Hyperlink>
        </TextBlock>

        <Button Content="OK" IsDefault="True" IsCancel="True" MinWidth="96" Margin="0,20,0,0"
                HorizontalAlignment="Right" Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
</Window>

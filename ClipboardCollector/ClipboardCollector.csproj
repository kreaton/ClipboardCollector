<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>ClipboardCollector</Product>
    <Copyright>Copyright © 2026 Per Hejndorf</Copyright>
    <!-- The version is set in Directory.Build.props. -->
    <!-- Velopack's Program.Main replaces the generated WPF entry point -->
    <StartupObject>ClipboardCollector.Program</StartupObject>
    <!-- WPF's Fluent theme (ThemeMode) is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
